# ZenRows API Key
# Get your API key from https://app.zenrows.com
ZENROWS_API_KEY=your_zenrows_api_key_here

# Supabase Configuration
# Get these credentials from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Default Scraper Settings
DEFAULT_JS_RENDER=false
DEFAULT_PREMIUM_PROXY=false
DEFAULT_ANTIBOT=true
