# ZenRows API Key (from https://app.zenrows.com)
ZENROWS_API_KEY=your_zenrows_api_key_here

# DataForSEO Credentials (from https://dataforseo.com/register)
DATAFORSEO_LOGIN=your_dataforseo_login_email
DATAFORSEO_PASSWORD=your_dataforseo_api_password

# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Supabase Credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Product ingestion routing: zenrows, dataforseo, or hybrid
PRODUCT_PROVIDER=hybrid

# Never enable this in production. It permits explicit offline fixture runs only.
ALLOW_DEMO_DATA=false

# Optional, read-only source for the one-time Strapi -> Supabase migration
LEGACY_STRAPI_URL=https://cms.fxnstudio.com
LEGACY_STRAPI_API_TOKEN=

# Default Scraper Settings
DEFAULT_JS_RENDER=false
DEFAULT_PREMIUM_PROXY=false
DEFAULT_ANTIBOT=true
